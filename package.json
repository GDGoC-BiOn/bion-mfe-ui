{
  "name": "@bion-mfe-ui/monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Bion MFE design system — framework-agnostic UI primitives shared across micro-frontends",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "build:tokens": "pnpm --filter @bion-mfe-ui/tokens build",
    "dev": "pnpm -r --parallel dev",
    "clean": "pnpm -r exec rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsup": "^8.2.0",
    "vite": "^5.4.0"
  }
}
