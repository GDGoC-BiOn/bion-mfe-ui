{
  "name": "@bion-mfe-ui/icons",
  "version": "0.1.0",
  "description": "Raw SVG icon set for Bion MFE UI. Framework-agnostic — exported as strings.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts"
  },
  "publishConfig": {
    "access": "public"
  }
}
